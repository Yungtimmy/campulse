# Public Supabase settings. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sign-in is Google only. Enable the Google provider in the Supabase dashboard
# (Authentication → Providers) and paste the Google OAuth client ID and secret.
# In Google Cloud, set the authorized redirect URI to:
# https://rdgkvosixhfzslgdneiw.supabase.co/auth/v1/callback
# Also allow this app's /auth/callback URL in Supabase Auth redirect URLs.

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Count is_demo incidents in the Campus Pulse score. Leave unset for real data only.
PULSE_INCLUDE_DEMO=false
